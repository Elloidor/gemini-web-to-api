# Server Configuration
PORT=4981
LOG_LEVEL=info
APP_ENV=development
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Gemini Configuration
# To get these values, visit https://gemini.google.com and log in
# Then open Developer Tools (F12) -> Application/Storage tab -> Cookies -> https://google.com
GEMINI_1PSID=
GEMINI_1PSIDTS=
# Optional: JSON object or CDP cookie export with live browser cookies.
# When set, this file replaces GEMINI_1PSID/GEMINI_1PSIDTS and is re-read before each RPC.
GEMINI_COOKIE_SYNC_FILE=
# Browser chat continuation API (/gemini/web/*). Disabled by default.
GEMINI_BROWSER_CHATS_ENABLED=false
# Required when enabled: API key (min 32 chars) sent as Authorization: Bearer <key> or ?key=<key>
GEMINI_BROWSER_CHATS_API_KEY=
GEMINI_REFRESH_INTERVAL=1440
GEMINI_MAX_RETRIES=3
GEMINI_TEMPORARY=false
